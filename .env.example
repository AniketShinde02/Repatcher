# AI Watermark Remover & Background Preserver — Environment Configuration
# Default: 100% Local Execution (No API keys or cloud credentials required)

# Application Server Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=7860

# Processing Configuration
DEFAULT_DEVICE=cuda # Options: cuda, cpu
DEFAULT_MODEL=lama  # Options: lama

# Storage Locations
OUTPUT_DIR=./processed_images
CLEANUP_TEMP_ON_SHUTDOWN=true
